# Change this to 'google' or 'bedrock' to instantly swap the backend
PRIMARY_LLM_PROVIDER=google
PRIMARY_LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.0

# API Keys (Only the active provider's key is strictly required)
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIzaSy...

# --- Database / Persistence ---
# Use local sqlite for development; swap to PostgreSQL URI for production
CHECKPOINT_DB_URL=sqlite:///./dev_checkpoints.db

# --- Environment ---
# Controls verbosity of LangGraph logs
LOG_LEVEL=INFO
ENVIRONMENT=development