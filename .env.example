# --- LLM Provider Keys ---
# Choose your primary reasoning engine
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# --- Database / Persistence ---
# Use local sqlite for development; swap to PostgreSQL URI for production
CHECKPOINT_DB_URL=sqlite:///./dev_checkpoints.db

# --- Environment ---
# Controls verbosity of LangGraph logs
LOG_LEVEL=INFO
ENVIRONMENT=development