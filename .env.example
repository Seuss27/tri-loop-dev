# =========================================================
# Tri-Loop Environment Configuration
# =========================================================

# --- Active LLM Provider ---
# Options: anthropic, google, bedrock
PRIMARY_LLM_PROVIDER=anthropic

# --- Active Models ---
# The PM uses a fast, cost-effective model for requirements
PM_MODEL=claude-3-haiku-20240307

# The Architect and Coder use high-reasoning models
ARCHITECT_MODEL=claude-3-5-sonnet-20240620
CODER_MODEL=claude-3-5-sonnet-20240620

# Global Temperature (keep at 0.0 for deterministic agent behavior)
LLM_TEMPERATURE=0.0

# --- LLM API Keys ---
# Only the active provider's key is required
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIzaSy...
# OPENAI_API_KEY=sk-...

# --- Database / Persistence ---
# Use local sqlite for development; swap to PostgreSQL URI for production
CHECKPOINT_DB_URL=sqlite:///./dev_checkpoints.db

# --- Environment ---
LOG_LEVEL=INFO
ENVIRONMENT=development